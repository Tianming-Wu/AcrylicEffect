@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
# (None currently - dwmapi is system library on Windows)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/WindowsVisualEffectTargets.cmake")

check_required_components(WindowsVisualEffect)

# Provide legacy variable for backward compatibility
set(WindowsVisualEffect_LIBRARIES WindowsVisualEffect)
set(WindowsVisualEffect_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/WindowsVisualEffect")

# Helper function to copy WindowsVisualEffect DLL to target output directory
function(copy_windowsvisualeffect_dll target)
    # Get the DLL location from the imported target
    get_target_property(_dll_location WindowsVisualEffect IMPORTED_LOCATION_RELEASE)
    get_target_property(_dll_location_debug WindowsVisualEffect IMPORTED_LOCATION_DEBUG)
    
    # Fallback: construct path from package prefix if imported location is not available
    if(NOT _dll_location)
        set(_dll_location "${PACKAGE_PREFIX_DIR}/bin/WindowsVisualEffect.dll")
    endif()
    if(NOT _dll_location_debug)
        set(_dll_location_debug "${PACKAGE_PREFIX_DIR}/bin/WindowsVisualEffectd.dll")
    endif()
    
    # Add post-build command to copy DLL
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "$<IF:$<CONFIG:Debug>,${_dll_location_debug},${_dll_location}>"
            "$<TARGET_FILE_DIR:${target}>"
        COMMENT "Copying WindowsVisualEffect DLL to output directory"
    )
endfunction()
